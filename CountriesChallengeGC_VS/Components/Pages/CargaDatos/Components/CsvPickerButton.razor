<div class="picker-root">
    <MudText Class="picker-label">@Label</MudText>
    <MudButton HtmlTag="label"
               Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.UploadFile"
               Disabled="@(Disabled || IsLoading)">
        @(IsLoading ? LoadingText : ButtonText)
        <InputFile OnChange="OnFileChanged" accept=".csv" style="display:none" />
    </MudButton>
    <MudText Class="picker-file">@(_fileName ?? "Sin archivo seleccionado")</MudText>
</div>

@code {
    private string? _fileName;

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ButtonText { get; set; } = string.Empty;
    [Parameter] public string LoadingText { get; set; } = "CARGANDO...";
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter, EditorRequired] public EventCallback<IBrowserFile?> FileChanged { get; set; }

    private async Task OnFileChanged(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _fileName = file?.Name;
        await FileChanged.InvokeAsync(file);
    }
}
