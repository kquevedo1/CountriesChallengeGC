@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-shell">
    <header class="app-header">
        <div class="app-brand">
            <img src="img/logo.svg" alt="Asazgua" class="app-brand-image" />
        </div>
        <div class="app-title">Países y Población</div>
    </header>

    <div class="app-body">
        <aside class="app-sidebar">
            <NavMenu />
        </aside>

        <main class="app-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
